{
  "_comment": "Example Claude Code hooks wiring for Agent-Lights-Communication. Merge the relevant blocks into your ~/.claude/settings.json (adjust the absolute paths). session-signal.py drives UserPromptSubmit/Stop/PostToolUse/Notification. session-signal-pretooluse.py (PreToolUse, matcher *) covers a blind spot: turns woken by a background agent's message / a notification skip UserPromptSubmit, so without it the work would show 'after green' instead of blue. Each hook is fail-open and prints nothing to stdout.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"/path/to/agent-lights-communication/examples/session-signal-pretooluse.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"/path/to/agent-lights-communication/examples/session-signal.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"/path/to/agent-lights-communication/examples/session-signal.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"/path/to/agent-lights-communication/examples/session-signal.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"/path/to/agent-lights-communication/examples/session-signal.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
