[Unit]
Description=Agent-Lights-Communication indicator daemon
After=openrgb-server.service
Wants=openrgb-server.service

[Service]
Type=simple
Environment=HOME=/root
# Adjust the interpreter path to your virtualenv (needs openrgb-python installed).
ExecStart=/opt/agent-lights/venv/bin/python /usr/local/bin/agent-lightsd.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
